{
  "annotations": { "list": [] },
  "description": "宿主机 / 物理机资源监控（CPU / 内存 / 磁盘 / 网络）",
  "editable": true,
  "schemaVersion": 39,
  "tags": [ "node-exporter", "linux", "host" ],
  "time": { "from": "now-1h", "to": "now" },
  "timepicker": {},
  "title": "Node Exporter - 主机资源监控",
  "uid": "node-exporter-dashboard",
  "version": 2,
  "templating": {
    "list": [
      {
        "name": "job",
        "type": "query",
        "datasource": "Prometheus",
        "refresh": 1,
        "query": "label_values(up, job)",
        "definition": "label_values(up, job)",
        "current": { "text": "All", "value": "$__all" },
        "includeAll": true,
        "multi": true,
        "label": "Job",
        "hide": 0
      },
      {
        "name": "instance",
        "type": "query",
        "datasource": "Prometheus",
        "refresh": 1,
        "query": "label_values(node_cpu_seconds_total, instance)",
        "definition": "label_values(node_cpu_seconds_total, instance)",
        "current": { "text": "All", "value": "$__all" },
        "includeAll": true,
        "multi": true,
        "label": "Instance",
        "hide": 0
      }
    ]
  },
  "panels": [
    {
      "type": "row",
      "title": "概览",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "在线主机数",
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "count(up)", "refId": "A" }],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-green" }, "mappings": [] },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "CPU 使用率",
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)", "refId": "A" }],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 80 }, { "color": "red", "value": 90 }] }, "mappings": [] },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "内存使用率",
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "(1 - (avg(node_memory_MemAvailable_bytes) / avg(node_memory_MemTotal_bytes))) * 100", "refId": "A" }],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 80 }, { "color": "red", "value": 90 }] }, "mappings": [] },
        "overrides": []
      }
    },
    {
      "type": "stat",
      "title": "磁盘使用率",
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "max((1 - node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|rpc_pipefs|nsfs\"} / node_filesystem_size_bytes) * 100)", "refId": "A" }],
      "options": {
        "colorMode": "value",
        "graphMode": "area",
        "justifyMode": "auto",
        "orientation": "auto",
        "reduceOptions": { "calcs": ["lastNotNull"], "fields": "", "values": false },
        "textMode": "auto"
      },
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100, "color": { "mode": "thresholds" }, "thresholds": { "mode": "absolute", "steps": [{ "color": "green", "value": null }, { "color": "orange", "value": 80 }, { "color": "red", "value": 90 }] }, "mappings": [] },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "CPU",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "CPU 使用率 (%)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 6 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "100 - (avg by (instance) (rate(node_cpu_seconds_total{mode=\"idle\"}[5m])) * 100)", "legendFormat": "{{instance}}", "refId": "A" }],
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": [] }
      },
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100, "color": { "mode": "palette-classic" }, "custom": { "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "hideFrom": { "legend": false, "tooltip": false, "viz": false }, "lineInterpolation": "linear", "lineWidth": 1, "pointSize": 5, "scaleDistribution": { "type": "linear" }, "showPoints": "auto", "spanNulls": false, "stacking": { "group": "A", "mode": "none" }, "thresholdsStyle": { "mode": "off" } } },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "内存",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "内存使用 (Bytes)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 15 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes", "legendFormat": "{{instance}} used", "refId": "A" }, { "expr": "node_memory_MemAvailable_bytes", "legendFormat": "{{instance}} free", "refId": "B" }],
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": [] }
      },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "color": { "mode": "palette-classic" }, "custom": { "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "hideFrom": { "legend": false, "tooltip": false, "viz": false }, "lineInterpolation": "linear", "lineWidth": 1, "pointSize": 5, "scaleDistribution": { "type": "linear" }, "showPoints": "auto", "spanNulls": false, "stacking": { "group": "A", "mode": "none" }, "thresholdsStyle": { "mode": "off" } } },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "交换区使用 (Bytes)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 15 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "node_memory_SwapTotal_bytes - node_memory_SwapFree_bytes", "legendFormat": "{{instance}}", "refId": "A" }],
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": [] }
      },
      "fieldConfig": {
        "defaults": { "unit": "bytes", "color": { "mode": "palette-classic" }, "custom": { "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "hideFrom": { "legend": false, "tooltip": false, "viz": false }, "lineInterpolation": "linear", "lineWidth": 1, "pointSize": 5, "scaleDistribution": { "type": "linear" }, "showPoints": "auto", "spanNulls": false, "stacking": { "group": "A", "mode": "none" }, "thresholdsStyle": { "mode": "off" } } },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "磁盘",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "磁盘使用率 (%)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 24 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "(1 - node_filesystem_avail_bytes{fstype!~\"tmpfs|overlay|rpc_pipefs|nsfs\"} / node_filesystem_size_bytes) * 100", "legendFormat": "{{instance}} {{mountpoint}}", "refId": "A" }],
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": [] }
      },
      "fieldConfig": {
        "defaults": { "unit": "percent", "min": 0, "max": 100, "color": { "mode": "palette-classic" }, "custom": { "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "hideFrom": { "legend": false, "tooltip": false, "viz": false }, "lineInterpolation": "linear", "lineWidth": 1, "pointSize": 5, "scaleDistribution": { "type": "linear" }, "showPoints": "auto", "spanNulls": false, "stacking": { "group": "A", "mode": "none" }, "thresholdsStyle": { "mode": "off" } } },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "网络",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 32 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "网络流量 (Bytes/sec)",
      "gridPos": { "h": 8, "w": 24, "x": 0, "y": 33 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "rate(node_network_receive_bytes_total{device!~\"lo|veth.*|docker.*\"}[5m])", "legendFormat": "{{instance}} {{device}} RX", "refId": "A" }, { "expr": "rate(node_network_transmit_bytes_total{device!~\"lo|veth.*|docker.*\"}[5m])", "legendFormat": "{{instance}} {{device}} TX", "refId": "B" }],
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": [] }
      },
      "fieldConfig": {
        "defaults": { "unit": "Bps", "color": { "mode": "palette-classic" }, "custom": { "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "hideFrom": { "legend": false, "tooltip": false, "viz": false }, "lineInterpolation": "linear", "lineWidth": 1, "pointSize": 5, "scaleDistribution": { "type": "linear" }, "showPoints": "auto", "spanNulls": false, "stacking": { "group": "A", "mode": "none" }, "thresholdsStyle": { "mode": "off" } } },
        "overrides": []
      }
    },
    {
      "type": "row",
      "title": "系统状态",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 41 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "平均负载 (Load Average)",
      "gridPos": { "h": 7, "w": 24, "x": 0, "y": 42 },
      "datasource": "Prometheus",
      "targets": [{ "expr": "node_load1", "legendFormat": "{{instance}} 1min", "refId": "A" }, { "expr": "node_load5", "legendFormat": "{{instance}} 5min", "refId": "B" }, { "expr": "node_load15", "legendFormat": "{{instance}} 15min", "refId": "C" }],
      "options": {
        "tooltip": { "mode": "multi", "sort": "none" },
        "legend": { "showLegend": true, "displayMode": "list", "placement": "bottom", "calcs": [] }
      },
      "fieldConfig": {
        "defaults": { "color": { "mode": "palette-classic" }, "custom": { "axisCenteredZero": false, "axisColorMode": "text", "axisLabel": "", "axisPlacement": "auto", "barAlignment": 0, "drawStyle": "line", "fillOpacity": 10, "gradientMode": "none", "hideFrom": { "legend": false, "tooltip": false, "viz": false }, "lineInterpolation": "linear", "lineWidth": 1, "pointSize": 5, "scaleDistribution": { "type": "linear" }, "showPoints": "auto", "spanNulls": false, "stacking": { "group": "A", "mode": "none" }, "thresholdsStyle": { "mode": "off" } } },
        "overrides": []
      }
    }
  ]
}

